{
  "name": "notification-preferences-service",
  "version": "1.0.0",
  "type": "module",
  "description": "Notification Preferences Service - single source of truth for user notification settings",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/infrastructure/db/migrations','dist/infrastructure/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/infrastructure/db/migrate-cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["notifications", "preferences"],
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.3.3",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
